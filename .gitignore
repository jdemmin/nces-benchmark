docs/_build/

# PyBuilder
.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to share your .python-version.
#   For an app, you might want to ignore it.
#.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, if you're executing a setup.py-based project, you may want to ignore it.
#Pipfile.lock

# poetry
#   Using Poetry, it is generally recommended to commit poetry.lock.
#poetry.lock

# pdm
#   Using PDM, it is generally recommended to commit pdm.lock and .pdm-python.
.pdm-plugins/

# PEP 582; used by e.g. github.com/davidhalter/jedi, pdm and rye
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

