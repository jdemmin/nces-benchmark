/src/directory_layout.txt
/src/benchmarking/inference.txt

# too large test data
/tests/lp/determinism/semantic_bible.owl
/tests/lp/determinism/test_lp_generation.py

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

